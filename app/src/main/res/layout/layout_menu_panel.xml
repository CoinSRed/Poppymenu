<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuPanel"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_menu"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Poppy Playtime Menu"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="✖"
            android:textColor="#FF5252"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="👤 اللاعب"
        android:textColor="#B0B0B0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="⚡ السرعة"
        android:textColor="#FFFFFF" />

    <SeekBar
        android:id="@+id/sbPlayerSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="4"
        android:progress="0" />

    <TextView
        android:id="@+id/tvPlayerSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1x"
        android:textColor="#00E676" />

    <Switch
        android:id="@+id/swFly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="✈️ طيران"
        android:textColor="#FFFFFF" />

    <Switch
        android:id="@+id/swNoclip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧱 اختراق الجدران"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="👹 الوحوش"
        android:textColor="#B0B0B0" />

    <Switch
        android:id="@+id/swEsp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👁️ خطوط عبر الجدران"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="🐌 إبطاء الوحوش"
        android:textColor="#FFFFFF" />

    <SeekBar
        android:id="@+id/sbEnemySlow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="2"
        android:progress="0" />

    <TextView
        android:id="@+id/tvEnemySlow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1x"
        android:textColor="#00E676" />

    <Switch
        android:id="@+id/swFreeze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="❄️ تجميد الوحوش"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🌍 العالم"
        android:textColor="#B0B0B0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="⏩ سرعة اللعبة"
        android:textColor="#FFFFFF" />

    <SeekBar
        android:id="@+id/sbGameSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="2"
        android:progress="0" />

    <TextView
        android:id="@+id/tvGameSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1x"
        android:textColor="#00E676" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#7C4DFF"
        android:text="حفظ الإعدادات"
        android:textColor="#FFFFFF" />
</LinearLayout>w
